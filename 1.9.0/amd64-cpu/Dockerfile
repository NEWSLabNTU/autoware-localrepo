# GENERATED by scripts/derive-cpu.py from the CUDA sibling; do not edit.
# GPU-free build: upstream's non-CUDA base image. Autoware's CUDA and
# TensorRT packages check CUDA_FOUND / TRT_AVAIL and build their CPU half
# or nothing. No CUDA environment, NVCC flags, cuDNN or TensorRT here.
FROM ghcr.io/autowarefoundation/autoware-base:latest


# acados (new build dependency of autoware_path_optimizer in 1.9.0).
# Mirrors ansible/roles/acados: full source tree + venv + tera renderer at
# /opt/acados (the package's codegen step hardcodes that layout), plus a
# second install into /usr/local so find_package(acados) works in the
# debian/rules pass without CMAKE_PREFIX_PATH (the generated rules build
# their own prefix path).
RUN git clone --depth 1 --branch v0.5.3 --recursive https://github.com/acados/acados.git /opt/acados && \
    cmake -S /opt/acados -B /opt/acados/build \
        -DACADOS_WITH_QPOASES=ON \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON && \
    make -C /opt/acados/build install -j"$(nproc)" && \
    cmake --install /opt/acados/build --prefix /usr/local

ADD https://github.com/acados/tera_renderer/releases/download/v0.2.0/t_renderer-v0.2.0-linux-amd64 /opt/acados/bin/t_renderer

RUN chmod 755 /opt/acados/bin/t_renderer && \
    python3 -m venv /opt/acados/.venv && \
    /opt/acados/.venv/bin/pip install --no-cache-dir --upgrade pip && \
    /opt/acados/.venv/bin/pip install --no-cache-dir casadi sympy && \
    /opt/acados/.venv/bin/pip install --no-cache-dir -e /opt/acados/interfaces/acados_template
ENV ACADOS_SOURCE_DIR=/opt/acados

# Configure the locale and timezone
RUN apt update -y && \
    apt install -y locales && \
    echo 'en_US.UTF-8 UTF-8' > /etc/locale.gen && \
    locale-gen && \
    update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8
ENV LANG=en_US.UTF-8
RUN ln -snf /usr/share/zoneinfo/Asia/Taipei /etc/localtime && \
    echo Asia/Taipei > /etc/timezone

# Configure AutonomouStuff APT repository for pacmod packages
RUN apt update -y && \
    apt install -y apt-transport-https && \
    rm -rf /var/lib/apt/lists/*
RUN echo "deb [trusted=yes] https://s3.amazonaws.com/autonomoustuff-repo/ $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/autonomoustuff-public.list > /dev/null

# Install additional ROS2 packages and development tools
RUN apt update -y && \
    apt install -y \
        ros-humble-rmw-cyclonedds-cpp \
        python3-rosdep \
        python3-colcon-common-extensions \
        python3-vcstool \
    && rm -rf /var/lib/apt/lists/*

# Set up ROS2 Python path (needed for ament_package module used by CMake)
ENV PYTHONPATH=/opt/ros/humble/lib/python3.10/site-packages:${PYTHONPATH}

# Create colcon2deb setup script to source ROS environment before build
RUN echo 'source /opt/ros/humble/setup.bash' > /colcon2deb-setup.sh

# Initialize rosdep
RUN rosdep init || true && rosdep update

# Install required dependencies to build Debian packages
RUN apt update -y && \
    apt install -y \
        parallel \
        fakeroot \
        debhelper \
        dh-python \
        rsync \
        sudo \
        python3-bloom \
        libgoogle-glog-dev \
        libgflags-dev \
    && rm -rf /var/lib/apt/lists/*

# Install cudnn_cmake_module and tensorrt_cmake_module for TensorRT support
RUN apt update -y && \
    apt install -y ros-humble-cudnn-cmake-module ros-humble-tensorrt-cmake-module \
    && rm -rf /var/lib/apt/lists/*

# NOTE on acados: Autoware 1.9.0 dropped universe/external/acados and
# universe/external/tera_renderer from repositories/autoware.repos, and upstream's
# docker/universe.Dockerfile now installs acados into the image instead. We
# deliberately do NOT install it here: nothing in the 1.9.0 workspace references
# acados (verified with `grep -ri acados src` over all 32 submodules -- zero hits;
# autoware_smart_mpc_trajectory_follower, the 1.7.1 consumer, no longer depends on
# it at universe 0.52.0). Revisit if a future bump reintroduces the dependency.

# Install message_filters - required by nebula_ros but sometimes not detected by rosdep
RUN apt update -y && \
    apt install -y ros-humble-message-filters \
    && rm -rf /var/lib/apt/lists/*

# Pre-install rosdep dependencies to speed up builds
COPY rosdep-packages.txt /tmp/rosdep-packages.txt
RUN apt update -y && \
    grep -v '^#' /tmp/rosdep-packages.txt | grep -v '^$' | xargs apt-get install -y --no-install-recommends || true && \
    rm -rf /var/lib/apt/lists/* /tmp/rosdep-packages.txt

# Set default process to bash
CMD ["/bin/bash"]
