# Deployment target for `just deploy` -- copy to deploy.env and fill in.
#
#   cp deploy.env.example deploy.env
#
# deploy.env is gitignored and MUST STAY THAT WAY: this repository is public
# on GitHub. Never commit deploy.env, a private GPG key, or any credential.
# The build host only ever needs your *private* key locally to sign; only the
# *public* key is shipped to users.

# --- NAS target (rsync over SSH) -------------------------------------------
# Use an SSH key, not a password: `ssh-copy-id autoware@nas.example.synology.me`
# On DSM: Control Panel > Terminal & SNMP > Enable SSH service.
NAS_HOST=nas.example.synology.me
NAS_USER=autoware

# Directory on the NAS that the web server serves from. With DSM's Web Station
# the default document root is /volume1/web, reachable at https://<host>/.
NAS_PATH=/volume1/web/autoware

# --- Public URL that apt clients will use ----------------------------------
# Must resolve to NAS_PATH above. Use https:// -- an unsigned or plaintext apt
# source lets anyone on the path inject packages that install as root.
REPO_BASE_URL=https://nas.example.synology.me/autoware

# --- Repository signing ----------------------------------------------------
# Long key ID or fingerprint of the key that signs Release. Generate one with:
#
#   gpg --quick-generate-key "NEWSLab Autoware Repository <you@example.com>" \
#       rsa4096 sign never
#   gpg --list-secret-keys --keyid-format=long
#
# Back the private key up somewhere safe and offline; losing it means every
# client must re-import a new key.
GPG_KEY_ID=0000000000000000
