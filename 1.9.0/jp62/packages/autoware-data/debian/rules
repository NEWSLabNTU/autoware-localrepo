#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	@echo "Creating download directories..."
	mkdir -p downloads/bevfusion
	mkdir -p downloads/calibration_status_classifier
	mkdir -p downloads/camera_streampetr
	mkdir -p downloads/diffusion_planner/v3.0
	mkdir -p downloads/diffusion_planner/v3.1
